# Copy to .env.deploy (gitignored) and fill in your host details.
# Used by scripts/deploy-next-app.sh — never commit .env.deploy.

# SSH target (user@host)
DEPLOY_HOST=user@your-server.example

# Remote path of the Next.js app on the server
DEPLOY_PATH=/path/to/next-app

# Docker container names (compose project dependent)
DEPLOY_NEXT_CONTAINER=next-app
DEPLOY_NPM_CONTAINER=nginx-proxy-manager

# Public site URL (for post-deploy tips only)
DEPLOY_SITE_URL=https://example.com
