# =============================================================================
# AJ Pacific — public-repo safe defaults
# Never commit secrets, TLS keys, NPM runtime data, or local env files.
# =============================================================================

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.log

# Agent / session noise (local only)
.grok/
.claude/
.agents/
.cursor/

# Dependencies & build
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo
# Generated by Next; recreate with next build/dev
website/next-app/next-env.d.ts

# -----------------------------------------------------------------------------
# Secrets & local env (never commit)
# -----------------------------------------------------------------------------
.env
.env.*
*.env
!.env.example
!**/.env.example
!.env.deploy.example
website/.env
website/next-app/.env
website/next-app/.env.local
website/next-app/.env*.local

# Host-specific ops (IPs, SSH targets, private runbooks)
.env.deploy
docs/OPS.local.md
docs/DEPLOYMENT.local.md
**/*.local.md
!docs/OPS.local.example.md
!**/*.local.example.md

# -----------------------------------------------------------------------------
# Nginx Proxy Manager / TLS runtime (must never go public)
# -----------------------------------------------------------------------------
website/data/
website/letsencrypt/

# Nested git history under website/ (contained secrets; keep local only)
website/.git/
website/.git-nested-local-backup/

# Optional local / VPS-only paths
website/memory/

# Keys, certs, ACME account material
*.pem
*.key
*.p12
*.pfx
**/privkey*.pem
**/fullchain*.pem
**/private_key.json
**/keys.json
**/database.sqlite
**/database.sqlite3
**/*.sqlite
**/*.sqlite3

# SSH key material if ever dropped in the tree
id_rsa
id_ed25519
id_ed25519.pub
*.pub
!**/public/**

# Local deploy / backup dumps
*.bak
*.backup
*.tar
*.tar.gz
*.zip
!**/public/**
